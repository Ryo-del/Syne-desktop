{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syne Desktop",
  "version": "0.1.0",
  "identifier": "ru.syne-network.desktop",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "externalBin": [
      "binaries/syne-desktop-api"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ]
  },
  "app": {
    "security": {
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "title": "Syne Desktop",
        "width": 1520,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "devtools": false
      }
    ]
  },
  "mainBinaryName": "Syne Desktop"
}